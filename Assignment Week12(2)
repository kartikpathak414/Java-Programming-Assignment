public class LateComersLine {

    // Custom Node class as required
    static class Node {
        String data;
        Node next;

        Node(String data) {
            this.data = data;
            this.next = null;
        }
    }

    // Inserts a student at the front of the line
    public static Node addFirst(Node head, String name) {
        Node newNode = new Node(name);
        newNode.next = head;
        return newNode;
    }

    // Inserts a student at the end of the line
    public static Node addLast(Node head, String name) {
        Node newNode = new Node(name);
        
        // If the line is empty, the new node becomes the head
        if (head == null) {
            return newNode;
        }

        // Traverse to the last node
        Node current = head;
        while (current.next != null) {
            current = current.next;
        }
        
        // Link the last node to the new node
        current.next = newNode;
        return head;
    }

    // Helper method to print the line in the required format
    public static void printLine(Node head) {
        Node current = head;
        while (current != null) {
            System.out.print(current.data + " -> ");
            current = current.next;
        }
        System.out.println("null");
    }

    public static void main(String[] args) {
        // --- Sample 1 ---
        System.out.println("Sample 1 Output:");
        Node line1 = null;
        line1 = addLast(line1, "Asha");
        line1 = addLast(line1, "Ravi");
        
        line1 = addFirst(line1, "Neha");
        line1 = addLast(line1, "Kiran");
        line1 = addFirst(line1, "Mohan");
        printLine(line1);

        // --- Sample 2 ---
        System.out.println("\nSample 2 Output:");
        Node line2 = null; // Starts empty
        
        line2 = addLast(line2, "Pooja");
        line2 = addFirst(line2, "Arun");
        printLine(line2);
    }
}
